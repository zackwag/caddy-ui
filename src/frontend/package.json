{
    "name": "caddy-ui-frontend",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "predev": "node scripts/fetch-caddyfile-mode.mjs",
        "dev": "vite",
        "prebuild": "node scripts/fetch-caddyfile-mode.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run && node scripts/localization.mjs check",
        "i18n:check": "node scripts/localization.mjs check",
        "i18n:coverage": "node scripts/localization.mjs coverage",
        "i18n:preview": "npm run i18n:preview --prefix ../../dev --",
        "i18n:preview:build": "npm run i18n:preview:build --prefix ../../dev --",
        "i18n:preview:capture": "npm run i18n:preview:capture --prefix ../../dev --",
        "i18n:preview:check-capture": "npm run i18n:preview:check-capture --prefix ../../dev --",
        "i18n:preview:check-browser": "npm run i18n:preview:check-browser --prefix ../../dev --"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/theme-one-dark": "^6.0.0",
        "@codemirror/view": "^6.43.14",
        "@fontsource-variable/noto-sans-arabic": "5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@simplewebauthn/browser": "14.0.0",
        "i18next": "^26.5.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.0",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
