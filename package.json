{
    "name": "caddy-ui-development",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:with-caddy": "node scripts/dev-caddy/dev.mjs",
        "dev:instances": "node scripts/dev-caddy/cli.mjs",
        "test:dev-caddy": "node --test scripts/dev-caddy/*.test.mjs test/integration/*.test.mjs",
        "test:dev-caddy:integration": "node --test test/integration/caddy.mjs test/integration/api.mjs test/integration/startup.mjs test/integration/diagnostics.mjs",
        "test:dev-caddy:e2e": "node --test frontend/e2e/error-logging.mjs",
        "lint:dev-caddy": "node backend/node_modules/eslint/bin/eslint.js --config backend/eslint.config.js scripts/dev-caddy test/integration",
        "docs:screenshots": "node docs/screenshots/screenshot.mjs",
        "docs:screenshots:capture": "node docs/screenshots/capture.mjs"
    }
}
