{
    "name": "caddy-ui-development",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:with-caddy": "node dev/dev-caddy/dev.mjs",
        "dev:instances": "node dev/dev-caddy/cli.mjs",
        "test:dev-caddy": "npm test --prefix dev --",
        "test:dev-caddy:integration": "npm run test:integration --prefix dev --",
        "test:dev-caddy:e2e": "npm run test:e2e --prefix dev --",
        "lint:dev-caddy": "npm run lint --prefix dev --",
        "docs:screenshots": "node docs/screenshots/screenshot.mjs",
        "docs:screenshots:capture": "node docs/screenshots/capture.mjs",
        "i18n:preview": "npm run i18n:preview --prefix dev --",
        "i18n:preview:build": "npm run i18n:preview:build --prefix dev --",
        "i18n:preview:capture": "npm run i18n:preview:capture --prefix dev --",
        "i18n:preview:check-capture": "npm run i18n:preview:check-capture --prefix dev --",
        "i18n:preview:check-browser": "npm run i18n:preview:check-browser --prefix dev --"
