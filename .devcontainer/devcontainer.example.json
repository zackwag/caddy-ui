{
    "name": "caddy-ui with host Docker",
    "image": "node:24-bookworm",
    "remoteUser": "node",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": { "username": "node" },
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "postCreateCommand": "npm --prefix backend ci && npm --prefix frontend ci && npm exec --prefix frontend -- playwright install --with-deps chromium",
    "remoteEnv": {
        "REMOTE_CONTAINERS": "true"
    },
    "forwardPorts": [3001, 5173],
    "portsAttributes": {
        "3001": { "label": "caddy-ui backend", "onAutoForward": "silent" },
        "5173": { "label": "caddy-ui frontend", "onAutoForward": "openBrowser" }
    }
}
