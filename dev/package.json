{
    "name": "caddy-ui-dev-tools",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "node --test dev-caddy/*.test.mjs integration/*.test.mjs",
        "test:playground": "vitest run playground/test/",
        "test:integration": "node --test integration/caddy.mjs integration/api.mjs integration/startup.mjs integration/diagnostics.mjs",
        "test:e2e": "node --test --test-concurrency=1 e2e/error-logging.mjs e2e/languages.mjs e2e/cross-site.mjs e2e/auth.mjs e2e/api-tokens.mjs",
        "lint": "node ../src/backend/node_modules/eslint/bin/eslint.js . --max-warnings=0",
        "prei18n:preview": "node ../src/frontend/scripts/fetch-caddyfile-mode.mjs",
        "i18n:preview": "vite --config playground/vite.config.js",
        "prei18n:preview:build": "node ../src/frontend/scripts/fetch-caddyfile-mode.mjs",
        "i18n:preview:build": "vite build --config playground/vite.config.js",
        "i18n:preview:capture": "node playground/capture.mjs",
        "i18n:preview:check-capture": "node --test playground/capture.integration.mjs",
        "prei18n:preview:check-browser": "node ../src/frontend/scripts/fetch-caddyfile-mode.mjs",
        "i18n:preview:check-browser": "node playground/check-browser.mjs",
        "test:cross-site:browser": "node --test e2e/cross-site.mjs",
        "dev:cloud-metadata": "python3 cloud-metadata/collect.py",
        "test:cloud-metadata": "python3 -m unittest discover -s cloud-metadata -p 'test_*.py'"
    },
    "devDependencies": {
        "@codemirror/view": "^6.43.14",
        "@vitejs/plugin-react": "^6.1.2",
        "i18next": "^26.4.4",
        "playwright": "1.64.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.16",
        "react-router-dom": "^7.18.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
